# Caddy v2 configuration for blinken.org
# Install as /etc/caddy/Caddyfile and run `systemctl reload caddy`.

blinken.org {
	encode zstd gzip
	log

	# Old gallery pages and previews
	@oldgallery path_regexp ^/gallery/(\d+|preview/.*)$
	redir @oldgallery /gallery/

	# Admin URLs for a show (/admin/12) are the admin page
	@adminShow path_regexp ^/admin/\d+/?$
	rewrite @adminShow /admin/index.html

	# The admin API checks the admin login itself
	reverse_proxy /api/* localhost:3000

	root * /srv/blinken/static
	file_server
}

# Redirect from the old hostname
blinken.eecs.umich.edu {
	redir https://blinken.org{uri}
}

# For older embedded clients that can't use HTTPS: only the original API
http://insecure.blinken.org {
	@legacy path /api/0/random /api/0/current /api/0/stream /api/0/hello-pi /api/0/publish /api/0/status/* /api/0/cancel/*
	handle @legacy {
		reverse_proxy localhost:3000
	}
	handle {
		redir https://blinken.org{uri}
	}
}
